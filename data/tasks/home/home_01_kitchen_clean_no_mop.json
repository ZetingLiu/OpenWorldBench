{
  "task_id": "home_01_kitchen_clean_no_mop",
  "spec_version": "0.1",
  "scenario_id": "home_01",
  "name": "厨房清洁—无拖把条件",
  "instruction": "请把厨房打扫干净，厨房桌面和地面都需要清洁。",
  "task_type": "composite",
  "capability_tags": [
    "navigation",
    "tool_use",
    "state_awareness",
    "multi_step",
    "search",
    "error_recovery"
  ],
  "max_steps": 30,
  "initial_state_patch": {},
  "goal": {
    "all_of": [
      {
        "entity": "kitchen_table_01",
        "field": "states.cleanliness",
        "op": "eq",
        "value": "clean"
      },
      {
        "entity": "kitchen_floor_01",
        "field": "states.cleanliness",
        "op": "eq",
        "value": "clean"
      }
    ]
  },
  "subgoals": [
    {
      "id": "cleaning_tool_found",
      "description": "找到了可用于清洁的工具",
      "cond": {
        "entity": "cleaning_rag_01",
        "field": "held_by",
        "op": "in",
        "value": ["left_hand", "right_hand"]
      }
    },
    {
      "id": "kitchen_table_clean",
      "description": "厨房桌面已经清洁",
      "cond": {
        "entity": "kitchen_table_01",
        "field": "states.cleanliness",
        "op": "eq",
        "value": "clean"
      }
    },
    {
      "id": "kitchen_floor_clean",
      "description": "厨房地面已经清洁",
      "cond": {
        "entity": "kitchen_floor_01",
        "field": "states.cleanliness",
        "op": "eq",
        "value": "clean"
      }
    }
  ],
  "walkthroughs": [
    {
      "description": "自行搜索并使用卫生间墙上的抹布清洁厨房桌面和地面",
      "actions": [
        {"action": "move_to", "params": {"area_id": "bathroom"}},
        {"action": "observe_scene", "params": {}},
        {
          "action": "open_container",
          "params": {"entity_id": "bathroom_cleaning_cabinet_01"}
        },
        {
          "action": "open_container",
          "params": {"entity_id": "cleaning_bucket_01"}
        },
        {"action": "pick_object", "params": {"entity_id": "cleaning_rag_01"}},
        {
          "action": "close_container",
          "params": {"entity_id": "cleaning_bucket_01"}
        },
        {
          "action": "close_container",
          "params": {"entity_id": "bathroom_cleaning_cabinet_01"}
        },
        {"action": "move_to", "params": {"area_id": "living_room"}},
        {"action": "move_to", "params": {"area_id": "kitchen"}},
        {
          "action": "apply_physical_tool",
          "params": {
            "tool_id": "cleaning_rag_01",
            "target_id": "kitchen_table_01",
            "intended_effect": "clean"
          }
        },
        {
          "action": "apply_physical_tool",
          "params": {
            "tool_id": "cleaning_rag_01",
            "target_id": "kitchen_floor_01",
            "intended_effect": "clean"
          }
        },
        {"action": "finish_task", "params": {}}
      ]
    }
  ]
}
