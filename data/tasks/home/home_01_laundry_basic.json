{
  "task_id": "home_01_laundry_basic",
  "spec_version": "0.1",
  "scenario_id": "home_01",
  "name": "衣物整理—洗涤",
  "instruction": "卧室床上有脏衬衫和脏裤子，阳台上有洗衣机。请把两件脏衣物放入洗衣机并启动洗涤。",
  "task_type": "composite",
  "capability_tags": [
    "navigation",
    "pick_and_place",
    "container_open_close",
    "device_operation",
    "multi_step",
    "hand_management",
    "search"
  ],
  "max_steps": 40,

  "initial_state_patch": {},

  "goal": {
    "all_of": [
      {
        "entity": "clothes_01",
        "field": "container_id",
        "op": "eq",
        "value": "washing_machine_01"
      },
      {
        "entity": "clothes_02",
        "field": "container_id",
        "op": "eq",
        "value": "washing_machine_01"
      },
      {
        "entity": "washing_machine_01",
        "field": "device_state",
        "op": "eq",
        "value": "running"
      }
    ]
  },

  "subgoals": [
    {
      "id": "clothes_01_collected",
      "description": "衬衫已被拾取或放入搬运容器",
      "cond": {
        "any_of": [
          { "entity": "clothes_01", "field": "held_by", "op": "in", "value": ["left_hand", "right_hand"] },
          { "entity": "clothes_01", "field": "container_id", "op": "in", "value": ["storage_box_01", "laundry_basket_01"] }
        ]
      }
    },
    {
      "id": "clothes_02_collected",
      "description": "裤子已被拾取或放入搬运容器",
      "cond": {
        "any_of": [
          { "entity": "clothes_02", "field": "held_by", "op": "in", "value": ["left_hand", "right_hand"] },
          { "entity": "clothes_02", "field": "container_id", "op": "in", "value": ["storage_box_01", "laundry_basket_01"] }
        ]
      }
    },
    {
      "id": "clothes_in_machine",
      "description": "两件衣物已放入洗衣机",
      "cond": {
        "all_of": [
          { "entity": "clothes_01", "field": "container_id", "op": "eq", "value": "washing_machine_01" },
          { "entity": "clothes_02", "field": "container_id", "op": "eq", "value": "washing_machine_01" }
        ]
      }
    }
  ],

  "walkthroughs": [
    {
      "description": "常规方案：分两次搬运，每次取一件放入洗衣机",
      "actions": [
        { "action": "move_to", "params": { "area_id": "bedroom" } },
        { "action": "observe_scene", "params": {} },
        { "action": "pick_object", "params": { "entity_id": "clothes_01" } },
        { "action": "move_to", "params": { "area_id": "living_room" } },
        { "action": "move_to", "params": { "area_id": "balcony" } },
        { "action": "open_container", "params": { "entity_id": "washing_machine_01" } },
        { "action": "place_object", "params": { "entity_id": "clothes_01", "target_id": "washing_machine_01" } },
        { "action": "close_container", "params": { "entity_id": "washing_machine_01" } },
        { "action": "move_to", "params": { "area_id": "living_room" } },
        { "action": "move_to", "params": { "area_id": "bedroom" } },
        { "action": "pick_object", "params": { "entity_id": "clothes_02" } },
        { "action": "move_to", "params": { "area_id": "living_room" } },
        { "action": "move_to", "params": { "area_id": "balcony" } },
        { "action": "open_container", "params": { "entity_id": "washing_machine_01" } },
        { "action": "place_object", "params": { "entity_id": "clothes_02", "target_id": "washing_machine_01" } },
        { "action": "close_container", "params": { "entity_id": "washing_machine_01" } },
        { "action": "start_device", "params": { "entity_id": "washing_machine_01" } },
        { "action": "finish_task", "params": {} }
      ]
    },
    {
      "description": "替代方案：使用收纳箱一次性搬运两件衣物",
      "actions": [
        { "action": "move_to", "params": { "area_id": "bedroom" } },
        { "action": "observe_scene", "params": {} },
        { "action": "open_container", "params": { "entity_id": "storage_box_01" } },
        { "action": "pick_object", "params": { "entity_id": "clothes_01" } },
        { "action": "place_object", "params": { "entity_id": "clothes_01", "target_id": "storage_box_01" } },
        { "action": "pick_object", "params": { "entity_id": "clothes_02" } },
        { "action": "place_object", "params": { "entity_id": "clothes_02", "target_id": "storage_box_01" } },
        { "action": "close_container", "params": { "entity_id": "storage_box_01" } },
        { "action": "pick_object", "params": { "entity_id": "storage_box_01" } },
        { "action": "move_to", "params": { "area_id": "living_room" } },
        { "action": "move_to", "params": { "area_id": "balcony" } },
        { "action": "open_container", "params": { "entity_id": "washing_machine_01" } },
        { "action": "open_container", "params": { "entity_id": "storage_box_01" } },
        { "action": "pick_object", "params": { "entity_id": "clothes_01" } },
        { "action": "place_object", "params": { "entity_id": "clothes_01", "target_id": "washing_machine_01" } },
        { "action": "pick_object", "params": { "entity_id": "clothes_02" } },
        { "action": "place_object", "params": { "entity_id": "clothes_02", "target_id": "washing_machine_01" } },
        { "action": "close_container", "params": { "entity_id": "washing_machine_01" } },
        { "action": "start_device", "params": { "entity_id": "washing_machine_01" } },
        { "action": "finish_task", "params": {} }
      ]
    }
  ]
}