{
  "task_id": "home_01_kitchen_safety_restore",
  "spec_version": "0.1",
  "scenario_id": "home_01",
  "name": "厨房离家安全复原",
  "instruction": "厨房刚使用完，电器、刀具和卫生状况都还没有妥善处理。请在离家前把厨房恢复到安全、整洁的状态。",
  "task_type": "composite",
  "capability_tags": [
    "navigation",
    "pick_and_place",
    "container_open_close",
    "device_operation",
    "tool_use",
    "state_awareness",
    "hand_management",
    "search",
    "multi_step",
    "error_recovery"
  ],
  "max_steps": 40,
  "initial_state_patch": {},
  "goal": {
    "all_of": [
      {"entity": "induction_cooker_01", "field": "device_state", "op": "eq", "value": "off"},
      {"entity": "kitchen_knife_01", "field": "container_id", "op": "eq", "value": "kitchen_drawer_01"},
      {"entity": "kitchen_table_01", "field": "states.cleanliness", "op": "eq", "value": "clean"},
      {"entity": "kitchen_floor_01", "field": "states.cleanliness", "op": "eq", "value": "clean"},
      {"entity": "kitchen_drawer_01", "field": "open_state", "op": "eq", "value": "closed"},
      {"entity": "bathroom_cleaning_cabinet_01", "field": "open_state", "op": "eq", "value": "closed"},
      {"entity": "cleaning_bucket_01", "field": "open_state", "op": "eq", "value": "closed"}
    ]
  },
  "subgoals": [
    {
      "id": "cooker_safe",
      "description": "电磁炉已关闭",
      "cond": {"entity": "induction_cooker_01", "field": "device_state", "op": "eq", "value": "off"}
    },
    {
      "id": "knife_stored",
      "description": "菜刀已收入刀具抽屉",
      "cond": {"entity": "kitchen_knife_01", "field": "container_id", "op": "eq", "value": "kitchen_drawer_01"}
    },
    {
      "id": "cleaning_tool_found",
      "description": "找到了合理的清洁工具",
      "cond": {
        "any_of": [
          {"entity": "cleaning_rag_01", "field": "held_by", "op": "in", "value": ["left_hand", "right_hand"]},
          {"entity": "towel_01", "field": "held_by", "op": "in", "value": ["left_hand", "right_hand"]}
        ]
      }
    },
    {
      "id": "kitchen_table_clean",
      "description": "厨房桌面已清洁",
      "cond": {"entity": "kitchen_table_01", "field": "states.cleanliness", "op": "eq", "value": "clean"}
    },
    {
      "id": "kitchen_floor_clean",
      "description": "厨房地面已清洁",
      "cond": {"entity": "kitchen_floor_01", "field": "states.cleanliness", "op": "eq", "value": "clean"}
    }
  ],
  "walkthroughs": [
    {
      "description": "先消除厨房安全隐患，再从卫生间嵌套容器中取抹布并完成清洁复原",
      "actions": [
        {"action": "move_to", "params": {"area_id": "kitchen"}},
        {"action": "observe_scene", "params": {}},
        {"action": "stop_device", "params": {"entity_id": "induction_cooker_01"}},
        {"action": "open_container", "params": {"entity_id": "kitchen_drawer_01"}},
        {"action": "pick_object", "params": {"entity_id": "kitchen_knife_01"}},
        {"action": "place_object", "params": {"entity_id": "kitchen_knife_01", "target_id": "kitchen_drawer_01"}},
        {"action": "close_container", "params": {"entity_id": "kitchen_drawer_01"}},
        {"action": "move_to", "params": {"area_id": "living_room"}},
        {"action": "move_to", "params": {"area_id": "bathroom"}},
        {"action": "observe_scene", "params": {}},
        {"action": "open_container", "params": {"entity_id": "bathroom_cleaning_cabinet_01"}},
        {"action": "open_container", "params": {"entity_id": "cleaning_bucket_01"}},
        {"action": "pick_object", "params": {"entity_id": "cleaning_rag_01"}},
        {"action": "close_container", "params": {"entity_id": "cleaning_bucket_01"}},
        {"action": "close_container", "params": {"entity_id": "bathroom_cleaning_cabinet_01"}},
        {"action": "move_to", "params": {"area_id": "living_room"}},
        {"action": "move_to", "params": {"area_id": "kitchen"}},
        {"action": "apply_physical_tool", "params": {"tool_id": "cleaning_rag_01", "target_id": "kitchen_table_01", "intended_effect": "clean"}},
        {"action": "apply_physical_tool", "params": {"tool_id": "cleaning_rag_01", "target_id": "kitchen_floor_01", "intended_effect": "clean"}},
        {"action": "finish_task", "params": {}}
      ]
    }
  ]
}
