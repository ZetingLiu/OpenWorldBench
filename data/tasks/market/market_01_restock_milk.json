{
  "task_id": "market_01_restock_milk",
  "spec_version": "0.1",
  "scenario_id": "market_01",
  "name": "缺货补货",
  "instruction": "生鲜区冷藏柜里的牛奶已经空了，需要补货。请去仓库从牛奶箱中取一瓶牛奶，放进冷藏柜并关上柜门。",
  "task_type": "composite",
  "capability_tags": [
    "navigation",
    "pick_and_place",
    "container_open_close"
  ],
  "max_steps": 20,

  "initial_state_patch": {
    "entities": {
      "milk_01": { "in": "milk_crate_01" }
    }
  },

  "goal": {
    "all_of": [
      {
        "any_of": [
          { "entity": "milk_01", "field": "container_id", "op": "eq", "value": "fridge_01" },
          { "entity": "milk_02", "field": "container_id", "op": "eq", "value": "fridge_01" }
        ]
      },
      { "entity": "fridge_01", "field": "open_state", "op": "eq", "value": "closed" }
    ]
  },

  "subgoals": [
    {
      "id": "milk_retrieved",
      "description": "已从牛奶箱取出一瓶牛奶",
      "cond": {
        "any_of": [
          { "entity": "milk_01", "field": "held_by", "op": "in", "value": ["left_hand", "right_hand"] },
          { "entity": "milk_01", "field": "container_id", "op": "in", "value": ["basket_01", "cart_01"] },
          { "entity": "milk_01", "field": "container_id", "op": "eq", "value": "fridge_01" },
          { "entity": "milk_02", "field": "held_by", "op": "in", "value": ["left_hand", "right_hand"] },
          { "entity": "milk_02", "field": "container_id", "op": "in", "value": ["basket_01", "cart_01"] },
          { "entity": "milk_02", "field": "container_id", "op": "eq", "value": "fridge_01" }
        ]
      }
    },
    {
      "id": "milk_stocked",
      "description": "牛奶已放入冷藏柜",
      "cond": {
        "any_of": [
          { "entity": "milk_01", "field": "container_id", "op": "eq", "value": "fridge_01" },
          { "entity": "milk_02", "field": "container_id", "op": "eq", "value": "fridge_01" }
        ]
      }
    }
  ],

  "walkthroughs": [
    {
      "description": "常规方案：进仓库→开箱取奶→放入冷藏柜",
      "actions": [
        { "action": "move_to", "params": { "area_id": "fresh_section" } },
        { "action": "move_to", "params": { "area_id": "storage" } },
        { "action": "open_container", "params": { "entity_id": "milk_crate_01" } },
        { "action": "pick_object", "params": { "entity_id": "milk_02" } },
        { "action": "close_container", "params": { "entity_id": "milk_crate_01" } },
        { "action": "move_to", "params": { "area_id": "fresh_section" } },
        { "action": "open_container", "params": { "entity_id": "fridge_01" } },
        { "action": "place_object", "params": { "entity_id": "milk_02", "target_id": "fridge_01" } },
        { "action": "close_container", "params": { "entity_id": "fridge_01" } },
        { "action": "finish_task", "params": {} }
      ]
    }
  ]
}
