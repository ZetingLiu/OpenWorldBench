{
  "task_id": "market_01_grocery_run",
  "spec_version": "0.1",
  "scenario_id": "market_01",
  "name": "日常采购",
  "instruction": "入口有购物车，请去生鲜区取苹果和牛奶，再去日用品区取薯片和纸巾，一起拿到收银台结账装袋。",
  "task_type": "composite",
  "capability_tags": [
    "navigation",
    "pick_and_place",
    "container_open_close",
    "multi_step",
    "hand_management",
    "search"
  ],
  "max_steps": 40,

  "initial_state_patch": {},

  "goal": {
    "all_of": [
      { "entity": "apple_01", "field": "container_id", "op": "in", "value": ["bag_01", "bag_02"] },
      { "entity": "milk_01", "field": "container_id", "op": "in", "value": ["bag_01", "bag_02"] },
      { "entity": "chips_01", "field": "container_id", "op": "in", "value": ["bag_01", "bag_02"] },
      { "entity": "tissue_01", "field": "container_id", "op": "in", "value": ["bag_01", "bag_02"] },
      { "entity": "pos_terminal_01", "field": "states.transaction_complete", "op": "eq", "value": true }
    ]
  },

  "subgoals": [
    {
      "id": "milk_collected",
      "description": "牛奶已放入购物车",
      "cond": { "entity": "milk_01", "field": "container_id", "op": "in", "value": ["cart_01", "basket_01"] }
    },
    {
      "id": "apple_collected",
      "description": "苹果已放入购物车",
      "cond": { "entity": "apple_01", "field": "container_id", "op": "in", "value": ["cart_01", "basket_01"] }
    },
    {
      "id": "snacks_collected",
      "description": "薯片和纸巾已放入购物车",
      "cond": {
        "all_of": [
          { "entity": "chips_01", "field": "container_id", "op": "in", "value": ["cart_01", "basket_01"] },
          { "entity": "tissue_01", "field": "container_id", "op": "in", "value": ["cart_01", "basket_01"] }
        ]
      }
    },
    {
      "id": "all_bagged",
      "description": "所有商品已装袋",
      "cond": {
        "all_of": [
          { "entity": "apple_01", "field": "container_id", "op": "in", "value": ["bag_01", "bag_02"] },
          { "entity": "milk_01", "field": "container_id", "op": "in", "value": ["bag_01", "bag_02"] },
          { "entity": "chips_01", "field": "container_id", "op": "in", "value": ["bag_01", "bag_02"] },
          { "entity": "tissue_01", "field": "container_id", "op": "in", "value": ["bag_01", "bag_02"] }
        ]
      }
    }
  ],

  "walkthroughs": [
    {
      "description": "常规方案：购物车一次性搬运四件商品",
      "actions": [
        { "action": "pick_object", "params": { "entity_id": "cart_01" } },
        { "action": "move_to", "params": { "area_id": "fresh_section" } },
        { "action": "observe_scene", "params": {} },
        { "action": "open_container", "params": { "entity_id": "fridge_01" } },
        { "action": "pick_object", "params": { "entity_id": "milk_01" } },
        { "action": "place_object", "params": { "entity_id": "milk_01", "target_id": "cart_01" } },
        { "action": "pick_object", "params": { "entity_id": "apple_01" } },
        { "action": "place_object", "params": { "entity_id": "apple_01", "target_id": "cart_01" } },
        { "action": "close_container", "params": { "entity_id": "fridge_01" } },
        { "action": "move_to", "params": { "area_id": "daily_aisles" } },
        { "action": "observe_scene", "params": {} },
        { "action": "pick_object", "params": { "entity_id": "chips_01" } },
        { "action": "place_object", "params": { "entity_id": "chips_01", "target_id": "cart_01" } },
        { "action": "pick_object", "params": { "entity_id": "tissue_01" } },
        { "action": "place_object", "params": { "entity_id": "tissue_01", "target_id": "cart_01" } },
        { "action": "move_to", "params": { "area_id": "checkout" } },
        { "action": "place_object", "params": { "entity_id": "cart_01", "target_id": "checkout_counter_01" } },
        { "action": "pick_object", "params": { "entity_id": "bag_01" } },
        { "action": "pick_object", "params": { "entity_id": "apple_01" } },
        { "action": "place_object", "params": { "entity_id": "apple_01", "target_id": "bag_01" } },
        { "action": "pick_object", "params": { "entity_id": "milk_01" } },
        { "action": "place_object", "params": { "entity_id": "milk_01", "target_id": "bag_01" } },
        { "action": "pick_object", "params": { "entity_id": "chips_01" } },
        { "action": "place_object", "params": { "entity_id": "chips_01", "target_id": "bag_01" } },
        { "action": "pick_object", "params": { "entity_id": "tissue_01" } },
        { "action": "place_object", "params": { "entity_id": "tissue_01", "target_id": "bag_01" } },
        { "action": "start_device", "params": { "entity_id": "pos_terminal_01" } },
        { "action": "finish_task", "params": {} }
      ]
    }
  ]
}
