{
  "task_id": "market_01_buy_milk",
  "spec_version": "0.1",
  "scenario_id": "market_01",
  "name": "购买牛奶",
  "instruction": "入口有购物篮，请去生鲜区从冷藏柜取一瓶牛奶，拿到收银台装袋后支付完成。",
  "task_type": "direct",
  "capability_tags": [
    "navigation",
    "pick_and_place",
    "container_open_close",
    "device_operation"
  ],
  "max_steps": 20,

  "initial_state_patch": {},

  "goal": {
    "all_of": [
      {
        "entity": "milk_01",
        "field": "container_id",
        "op": "in",
        "value": ["bag_01", "bag_02"]
      },
      {
        "entity": "pos_terminal_01",
        "field": "states.transaction_complete",
        "op": "eq",
        "value": true
      }
    ]
  },

  "subgoals": [
    {
      "id": "milk_collected",
      "description": "牛奶已从冷藏柜取出",
      "cond": {
        "entity": "milk_01",
        "field": "container_id",
        "op": "in",
        "value": ["basket_01", "cart_01", "bag_01", "bag_02"]
      }
    },
    {
      "id": "payment_complete",
      "description": "支付已完成",
      "cond": {
        "entity": "pos_terminal_01",
        "field": "states.transaction_complete",
        "op": "eq",
        "value": true
      }
    }
  ],

  "walkthroughs": [
    {
      "description": "常规方案：取篮→取奶→装袋→支付",
      "actions": [
        { "action": "pick_object", "params": { "entity_id": "basket_01" } },
        { "action": "move_to", "params": { "area_id": "fresh_section" } },
        { "action": "open_container", "params": { "entity_id": "fridge_01" } },
        { "action": "pick_object", "params": { "entity_id": "milk_01" } },
        { "action": "place_object", "params": { "entity_id": "milk_01", "target_id": "basket_01" } },
        { "action": "close_container", "params": { "entity_id": "fridge_01" } },
        { "action": "move_to", "params": { "area_id": "checkout" } },
        { "action": "place_object", "params": { "entity_id": "basket_01", "target_id": "checkout_counter_01" } },
        { "action": "pick_object", "params": { "entity_id": "bag_01" } },
        { "action": "pick_object", "params": { "entity_id": "milk_01" } },
        { "action": "place_object", "params": { "entity_id": "milk_01", "target_id": "bag_01" } },
        { "action": "start_device", "params": { "entity_id": "pos_terminal_01" } },
        { "action": "finish_task", "params": {} }
      ]
    }
  ]
}
